font-family ="Fira Code"
font-size = 12
mouse-hide-while-typing = true
link-previews = true
window-padding-x = 5
window-padding-y = 5
quit-after-last-window-closed = true

keybind = shift+enter=text:\n
keybind = shift+kp_enter=text:\n

keybind = ctrl+enter=text:\r
keybind = ctrl+kp_enter=text:\r

# PageUp/PageDown without the fn key (fn is bound to dictation), so
# fullscreen TUIs like Claude Code can be scrolled from the laptop keyboard.
keybind = alt+up=csi:5~
keybind = alt+down=csi:6~

clipboard-write = allow
clipboard-read = ask
